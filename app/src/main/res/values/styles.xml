<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/bg_panel</item>
        <item name="android:colorPrimaryDark">@color/bg_root</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="android:colorControlHighlight">@color/accent_dim</item>
        <item name="android:colorBackground">@color/bg_root</item>
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:statusBarColor">@color/bg_root</item>
        <item name="android:navigationBarColor">@color/bg_root</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
        <item name="android:colorEdgeEffect">@color/accent</item>
      <!-- every AlertDialog.Builder(this) call in the app picks this up, so the
           dialogs match the console instead of falling back to the platform -->
      <item name="android:alertDialogTheme">@style/AppTheme.Dialog</item>
    </style>

    <style name="AppTheme.Dialog" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowTitleStyle">@style/DialogTitle</item>
    </style>

    <style name="DialogTitle" parent="@android:style/TextAppearance.Material.DialogWindowTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_head</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ======================= type ======================= -->
    <style name="T" parent="@android:style/TextAppearance.Material">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="T.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="T.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="T.Head">
        <item name="android:textSize">@dimen/text_head</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="T.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="T.Dim">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="T.Caption">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="T.Section">
        <item name="android:textSize">@dimen/text_tiny</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="T.Mono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="T.MonoBig">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">@dimen/text_mono_l</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- ======================= controls ======================= -->
    <style name="Btn" parent="@android:style/Widget.Material.Button.Borderless.Small">
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/btn_h</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">@dimen/space_l</item>
        <item name="android:paddingRight">@dimen/space_l</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Btn.Primary">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/bg_root</item>
    </style>
    <style name="Btn.Danger">
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textColor">@color/rec</item>
    </style>
    <style name="Btn.Rec">
        <item name="android:background">@drawable/bg_btn_rec</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>
    <style name="Btn.Small">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:minHeight">@dimen/btn_h_sm</item>
        <item name="android:paddingLeft">@dimen/space_m</item>
        <item name="android:paddingRight">@dimen/space_m</item>
    </style>
    <style name="Btn.Icon" parent="Btn">
        <item name="android:minWidth">@dimen/btn_h</item>
        <item name="android:minHeight">@dimen/btn_h</item>
        <item name="android:paddingLeft">@dimen/space_s</item>
        <item name="android:paddingRight">@dimen/space_s</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/space_l</item>
    </style>
    <style name="Row">
        <item name="android:background">@drawable/bg_list_row</item>
        <item name="android:minHeight">@dimen/row_h</item>
        <item name="android:paddingLeft">@dimen/space_l</item>
        <item name="android:paddingRight">@dimen/space_l</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="Input" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:padding">@dimen/space_m</item>
        <item name="android:minHeight">@dimen/btn_h</item>
    </style>
    <style name="Spinner" parent="@android:style/Widget.Material.Spinner.Underlined">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingLeft">@dimen/space_m</item>
        <item name="android:paddingRight">@dimen/space_m</item>
        <item name="android:popupBackground">@color/bg_card_hi</item>
    </style>
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/stroke_soft</item>
    </style>
    <style name="Chip" parent="@android:style/Widget.Material.Button.Borderless.Small">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">@dimen/btn_h_sm</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">@dimen/space_m</item>
        <item name="android:paddingRight">@dimen/space_m</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
