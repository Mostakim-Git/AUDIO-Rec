        <attr name="lmChannels" format="integer" />
        <attr name="lmShowScale" format="boolean" />
        <attr name="lmPeakHoldMs" format="integer" />
        <attr name="lmHorizontal" format="boolean" />
    </declare-styleable>
    <declare-styleable name="WaveScopeView">
        <attr name="wsGrid" format="boolean" />
