<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rec_dim" />
            <corners android:radius="@dimen/radius_m" />
            <stroke android:width="@dimen/stroke_w" android:color="@color/rec" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFF3B45" />
            <corners android:radius="@dimen/radius_m" />
            <stroke android:width="@dimen/stroke_w" android:color="#66FF3B45" />
        </shape>
    </item>
</selector>
