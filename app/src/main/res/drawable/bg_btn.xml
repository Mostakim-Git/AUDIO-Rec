<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_hi" />
            <corners android:radius="@dimen/radius_m" />
            <stroke android:width="@dimen/stroke_w" android:color="@color/accent" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_sunken" />
            <corners android:radius="@dimen/radius_m" />
            <stroke android:width="@dimen/stroke_w" android:color="@color/stroke_soft" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="@dimen/radius_m" />
            <stroke android:width="@dimen/stroke_w" android:color="@color/stroke" />
        </shape>
    </item>
</selector>
